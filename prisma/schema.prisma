// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id               String   @id @default(uuid())
  sourceType       String   @default("gazette")
  fileName         String
  fileUrl          String
  mimeType         String?
  fileSize         Int?
  processingStatus String   @default("pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  text             DocumentText?
  tags             DocumentTag[]
  chunks           DocumentChunk[]

  @@map("documents")
}

model DocumentText {
  documentId String   @id
  content    String?
  summary    String?
  extractedAt DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_texts")
}


model DocumentTag {
  documentId String
  tag        String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, tag])
  @@map("document_tags")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  index      Int
  text       String
  embedding  Json?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, index])
  @@map("document_chunks")
}
