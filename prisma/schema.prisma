generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* =========================
   DOCUMENTS
========================= */

model Document {
  id               String   @id @default(uuid())
  sourceType       String   @default("gazette")
  fileName         String
  fileUrl          String
  mimeType         String?
  fileSize         Int?
  processingStatus ProcessingStatus @default(pending)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  text             DocumentText?
  tags             DocumentTag[]        // free-text labels
  sicTags          DocumentSicTag[]     // structured SIC tagging
  chunks           DocumentChunk[]

  @@map("documents")
}

enum ProcessingStatus {
  pending
  text_extracted
  chunked
  classified
  reviewed
  failed
}

/* =========================
   DOCUMENT TEXT
========================= */

model DocumentText {
  documentId  String   @id
  content     String?
  summary     String?
  extractedAt DateTime @default(now())
  tsv         Unsupported("tsvector")?
  embedding   Unsupported("vector(1536)")?

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_texts")
}

/* =========================
   FREE-TEXT TAGS (NON-SIC)
========================= */

model DocumentTag {
  documentId String
  tag        String

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, tag])
  @@map("document_tags")
}

/* =========================
   DOCUMENT CHUNKS
========================= */

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  index      Int
  text       String
  embedding  Json?
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, index])
  @@map("document_chunks")
}

/* =========================
   SIC HIERARCHY
========================= */

model SicNode {
  id           String   @id @default(uuid())

  parentId     String?
  parent       SicNode?  @relation("SicHierarchy", fields: [parentId], references: [id])
  children     SicNode[] @relation("SicHierarchy")

  level        SicLevel
  code         String?
  title        String?
  description  String?
  hasContent   Boolean  @default(false)

  // data-quality flags
  isDuplicate  Boolean  @default(false)
  isInferred   Boolean  @default(false)
  isTruncated  Boolean  @default(false)

  // lifecycle / normalization
  isActive     Boolean  @default(true)
  supersededBy String?  // SicNode.id (soft reference)

  // provenance
  sourceDoc    String?
  sourcePage   Int?

  // embedding vector for semantic search
  embedding    Unsupported("vector(1536)")?

  // optional but powerful
  path         String?

  createdAt    DateTime @default(now())

  documentTags DocumentSicTag[]
  signals      SicSignal[]

  @@index([level])
  @@index([code])
  @@index([isActive])
}

/* =========================
   SIC SIGNALS (ENTERPRISE)
========================= */

model SicSignal {
  id               String     @id @default(uuid())

  sicNodeId        String
  sicNode          SicNode    @relation(fields: [sicNodeId], references: [id], onDelete: Cascade)

  // original extracted text
  signalValue      String

  // normalized for deterministic matching
  normalizedValue  String

  type             SignalType

  // scoring
  weight           Float
  specificity      Float      @default(1)

  // governance
  createdBy        String     @default("auto") // auto | ai | manual
  isActive         Boolean    @default(true)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([sicNodeId])
  @@index([normalizedValue])
  @@index([type])
  @@index([specificity])
  @@unique([sicNodeId, normalizedValue, type])
}

enum SignalType {
  core
  phrase
  verb
  synonym
  negative
  boost
}

enum SicLevel {
  industry
  division
  class
  group
}

/* =========================
   DOCUMENT ↔ SIC TAGGING
========================= */

model DocumentSicTag {
  documentId String
  sicNodeId  String

  confidence Float?
  tagSource  TagSource
  notes      String?

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sicNode    SicNode  @relation(fields: [sicNodeId], references: [id], onDelete: Cascade)

  @@id([documentId, sicNodeId])
  @@index([sicNodeId])
}


enum TagSource {
  ai
  manual
  rule
}
