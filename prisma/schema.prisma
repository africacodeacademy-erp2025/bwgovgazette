generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id               String          @id @default(uuid())
  sourceType       String          @default("gazette")
  fileName         String
  fileUrl          String
  mimeType         String?
  fileSize         Int?
  processingStatus String          @default("pending")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  chunks           DocumentChunk[]
  tags             DocumentTag[]
  text             DocumentText?

  @@map("documents")
}

model DocumentText {
  documentId  String   @id
  content     String?
  summary     String?
  extractedAt DateTime @default(now())

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_texts")
}

model DocumentTag {
  documentId String
  tag        String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([documentId, tag])
  @@map("document_tags")
}

model DocumentChunk {
  id         String   @id @default(uuid())
  documentId String
  index      Int
  text       String
  embedding  Json?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, index])
  @@map("document_chunks")
}

model SicNode {
  id           String   @id @default(uuid())

  parentId     String?
  parent       SicNode?  @relation("SicHierarchy", fields: [parentId], references: [id])
  children     SicNode[] @relation("SicHierarchy")

  level        SicLevel
  code         String?
  title        String?
  description  String?

  // data-quality flags
  isDuplicate  Boolean  @default(false)
  isInferred   Boolean  @default(false)
  isTruncated  Boolean  @default(false)

  // lifecycle / normalization
  isActive     Boolean  @default(true)
  supersededBy String?  // SicNode.id (soft reference)

  // provenance
  sourceDoc    String?
  sourcePage   Int?

  // optional but powerful
  path         String?

  createdAt    DateTime @default(now())

  documentTags DocumentSicTag[]

  @@index([level])
  @@index([code])
  @@index([isActive])
}

enum SicLevel {
  industry
  division
  class
  group
}

/* =========================
   DOCUMENT ↔ SIC TAGGING
========================= */

model DocumentSicTag {
  documentId String
  sicNodeId  String

  confidence Float?
  tagSource  TagSource
  notes      String?

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sicNode    SicNode  @relation(fields: [sicNodeId], references: [id], onDelete: Cascade)

  @@id([documentId, sicNodeId])
  @@index([sicNodeId])
}

enum TagSource {
  ai
  manual
  rule
}
